[Unit]
Description=BTX fork witness (serves /blocks/tip/height and /block-height/<h>)
After=network-online.target btxd.service
Wants=network-online.target

[Service]
# Replace USER and the datadir for your host.
#
# THE POINT OF THIS UNIT. A wallet settles a fork by comparing the block hash
# at a height two sources both hold. That is two read-only routes. Esplora mode
# answers them too and needs electrs, a full 124 GiB archival chain and a
# prune=0 datadir — all of which exist for the ADDRESS index, which a witness
# is never asked about and must never be trusted for.
#
# Pruning discards block DATA, not the block INDEX, so ANY node can serve this,
# including one on prune=10000 that could never serve Esplora. Measured against
# this project's own validator (pruneheight 184942) on 2026-09-06: it answered
# heights 1, 50000 and 150000 correctly, all far below that.
#
# So this is the tier every operator can run, and the one the network is
# actually short of: the wallet's only witness has been frozen for days.
User=USER
Type=simple
# Loopback only. deploy/esplora/Caddyfile.template goes in front for TLS, CORS
# and rate limiting, exactly as it does for electrs — point it here by setting
# BTX_ESPLORA_ELECTRS=127.0.0.1:3081, and the freshness guardian works
# unchanged, because it reads these same two routes.
ExecStart=/usr/local/bin/btx-witness --datadir /var/lib/btx --rpc 127.0.0.1:19334 --listen 127.0.0.1:3081
Restart=on-failure
RestartSec=10

# It reads the node's cookie and answers two GETs. It needs nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
